#!/usr/bin/env bash
# Invoke a HOST bridge MCP tool from inside the container.
# Usage: bridge-call <tool> [json-args]
# Example: bridge-call read_file '{"path":"/Users/me/note.txt"}'
# Example: bridge-call terminal_exec '{"command":"uname -a"}'
set -euo pipefail

TOOL="${1:-}"
ARGS_JSON="${2:-{}}"
if [[ -z "$TOOL" ]]; then
  echo "usage: bridge-call <tool> [json-args]" >&2
  exit 2
fi

CRED="${BRIDGE_CREDENTIALS_FILE:-}"
if [[ -z "$CRED" || ! -f "$CRED" ]]; then
  echo "BRIDGE_CREDENTIALS_FILE missing" >&2
  exit 1
fi

BRIDGE_URL="${BRIDGE_URL:-http://host.docker.internal:7331}"
TOKEN="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["token"])' "$CRED")"

# Prefer system curl (not the shim) for loopback/host bridge control plane
REAL_CURL=/usr/bin/curl
exec "$REAL_CURL" -sS \
  -H "Authorization: Bearer ${TOKEN}" \
  -H "Content-Type: application/json" \
  -d "$(python3 -c 'import json,sys; print(json.dumps({"arguments": json.loads(sys.argv[1])}))' "$ARGS_JSON")" \
  "${BRIDGE_URL}/v1/tools/${TOOL}/invoke"
