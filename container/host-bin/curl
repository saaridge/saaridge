#!/usr/bin/env bash
# curl shim — always go through the local auth-proxy → host bridge MITM proxy.
# If args contain vault:// (or X-OneBridge-Mediate), force bridge-owned
# vault_http so secrets never ride a blind TUNNEL.
set -euo pipefail

REAL_CURL="/usr/bin/curl"
if [[ ! -x "$REAL_CURL" ]]; then
  REAL_CURL="$(type -P curl 2>/dev/null || true)"
fi
# Avoid recursion if somehow still pointing at this script
if [[ "${REAL_CURL:-}" == *"/opt/bridge/host-bin/curl" ]]; then
  REAL_CURL="/bin/curl"
fi
if [[ ! -x "${REAL_CURL:-}" ]]; then
  echo "curl not found on system" >&2
  exit 127
fi

# Detect redacted / mediate-required requests before opening a TUNNEL.
NEED_MEDIATE=0
for arg in "$@"; do
  case "$arg" in
    *vault://*|*"X-OneBridge-Mediate"*|*"x-onebridge-mediate"*)
      NEED_MEDIATE=1
      break
      ;;
  esac
done

if [[ "$NEED_MEDIATE" -eq 1 ]]; then
  if [[ ! -x /opt/bridge/host-bin/bridge-call ]]; then
    echo "curl shim: vault:// requires bridge-call (MEDIATE) but it is missing" >&2
    exit 1
  fi
  ARGS_JSON="$(python3 - "$@" <<'PY'
import json, sys
args = sys.argv[1:]
method = "GET"
url = None
headers = {}
body = None
i = 0
while i < len(args):
    a = args[i]
    if a in ("-X", "--request") and i + 1 < len(args):
        method = args[i + 1]
        i += 2
        continue
    if a in ("-H", "--header") and i + 1 < len(args):
        h = args[i + 1]
        if ":" in h:
            k, v = h.split(":", 1)
            headers[k.strip()] = v.strip()
        i += 2
        continue
    if a in ("-d", "--data", "--data-raw", "--data-binary", "--data-urlencode") and i + 1 < len(args):
        body = args[i + 1]
        if method == "GET":
            method = "POST"
        i += 2
        continue
    if a.startswith("http://") or a.startswith("https://") or a.startswith("vault://"):
        url = a
        i += 1
        continue
    i += 1
if not url:
    print("curl shim: could not find URL for vault mediate", file=sys.stderr)
    sys.exit(2)
# Drop mediate header — bridge path is already mediate
headers = {k: v for k, v in headers.items() if k.lower() != "x-onebridge-mediate"}
print(json.dumps({"method": method, "url": url, "headers": headers, "body": body}))
PY
)"
  exec /opt/bridge/host-bin/bridge-call vault_http "$ARGS_JSON"
fi

PROXY="${HTTP_PROXY:-${http_proxy:-}}"
if [[ -z "$PROXY" && -n "${LOCAL_PROXY_PORT:-}" ]]; then
  PROXY="http://127.0.0.1:${LOCAL_PROXY_PORT}"
fi
if [[ -z "$PROXY" && -f "${BRIDGE_CREDENTIALS_FILE:-}" ]]; then
  PORT="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["localProxyPort"])' "$BRIDGE_CREDENTIALS_FILE")"
  PROXY="http://127.0.0.1:${PORT}"
fi

if [[ -n "$PROXY" ]]; then
  exec "$REAL_CURL" --proxy "$PROXY" --proxy-insecure "$@"
fi
exec "$REAL_CURL" "$@"
